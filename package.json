{
  "name": "storyforge",
  "version": "0.1.0",
  "description": "Narrative intelligence engine — Electron + React + Claude AI desktop app for creative writing",
  "license": "MIT",
  "author": {
    "name": "Vedant Bansal",
    "email": "vedant@bwits.tech",
    "url": "https://github.com/VedantSB207"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VedantSB207/storyforge.git"
  },
  "bugs": {
    "url": "https://github.com/VedantSB207/storyforge/issues"
  },
  "homepage": "https://github.com/VedantSB207/storyforge#readme",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server.js\"",
    "dev:electron": "NODE_ENV=development concurrently \"vite\" \"node server.js\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "build:mac": "ELECTRON_BUILD=1 vite build && electron-builder --mac",
    "preview": "vite preview"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "docx": "^9.6.1",
    "electron-store": "^8.1.0",
    "express": "^4.18.2",
    "jspdf": "^4.2.1",
    "konva": "^9.3.22",
    "mammoth": "^1.6.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^5.5.207",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-force-graph-2d": "^1.29.1",
    "react-konva": "^18.2.16"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "tech.bwits.storyforge",
    "productName": "StoryForge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!node_modules/@esbuild",
      "!node_modules/vite",
      "!node_modules/@vitejs"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "identity": null
    },
    "asar": true,
    "afterSign": null
  }
}
